# OpenWeatherMap API key (required) — get one at https://openweathermap.org/api
OPENWEATHER_API_KEY=your_api_key_here

# Admin panel token — set a strong secret to enable admin endpoints.
# Leave empty to keep admin and debug endpoints disabled.
ADMIN_TOKEN=

# Exact browser origins allowed to call the API, separated by commas.
# Example: https://weather.example.com,http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# Runtime state and logs. Use a persistent mounted directory in production.
WEATHER_DATA_DIR=
